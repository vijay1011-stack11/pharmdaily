---
import Figure from '../Figure.astro';
import Curves from '../Curves.astro';
const sig = (e50: number, max: number, n = 2) => (lg: number) => max / (1 + Math.pow(10, (e50 - lg) * n));
const log = [[-2, '0.01'], [-1, '0.1'], [0, '1'], [1, '10'], [2, '100'], [3, '1000']] as [number, string][];
---
<Figure viewBox="0 0 340 210" maxWidth={520} label="Therapeutic effect curve and toxic effect curve against dose, with ED50, LD50 and the therapeutic window between them">
  <Curves
    x={[-2, 3]}
    xLabel="Dose (log scale)"
    yLabel="% of subjects"
    ticks={log}
    band={[0.5, 1.1]}
    marks={[[0, 'ED50'], [1.8, 'LD50']]}
    series={[
      { f: sig(0, 100), cls: 'ln-good', label: 'therapeutic effect', lx: -1.95, ly: 88, tcls: 'ts tg' },
      { f: sig(1.8, 100), cls: 'ln-bad', label: 'toxic effect', lx: 2.05, ly: 30, tcls: 'ts tb' },
    ]}
  />
  <Fragment slot="caption">Shaded: the <b>therapeutic window</b>.</Fragment>
</Figure>
