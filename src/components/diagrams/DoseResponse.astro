---
import Figure from '../Figure.astro';
import Curves from '../Curves.astro';
// Replaces the review page's JS-drawn chart; the legend keeps its exact text.
const sig = (e50: number, max: number, n = 1.6) => (lg: number) => max / (1 + Math.pow(10, (e50 - lg) * n));
const log = [[-2, '0.01'], [-1, '0.1'], [0, '1'], [1, '10'], [2, '100'], [3, '1000']] as [number, string][];
---
<Figure viewBox="0 0 340 210" maxWidth={520} label="Log dose response curves for three drugs: B is right of A (less potent, same efficacy); C is lower (same potency, less efficacy)">
  <Curves
    x={[-2, 3]}
    xLabel="Dose (log scale)"
    yLabel="Response"
    ticks={log}
    marks={[[0, 'EC50 of A']]}
    series={[
      { f: sig(0, 100), cls: 'ln-pri', label: 'A', lx: -0.1, ly: 78, anchor: 'end', tcls: 'ts tp' },
      { f: sig(1, 100), cls: 'ln-sec', label: 'B', lx: 1.35, ly: 46, tcls: 'ts tsec' },
      { f: sig(0, 60), cls: 'ln-bad', label: 'C', lx: 1.6, ly: 66, tcls: 'ts tb' },
    ]}
  />
  <div slot="after" class="keys">
    <span><i style="background:var(--primary)"></i>A: reference</span>
    <span><i style="background:var(--sec)"></i>B: less potent, same efficacy</span>
    <span><i style="background:var(--bad)"></i>C: same potency, less efficacy</span>
  </div>
</Figure>
