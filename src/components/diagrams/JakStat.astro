---
import Figure from '../Figure.astro';
---
<Figure viewBox="0 0 340 236" maxWidth={520} label="Receptor with no enzyme of its own recruits JAK; JAK phosphorylates STAT; the STAT dimer moves to the nucleus">
  <rect class="lipid" x="0" y="50" width="340" height="40" />
  <line class="ln-faint" x1="0" y1="50" x2="340" y2="50" /><line class="ln-faint" x1="0" y1="90" x2="340" y2="90" />
  <circle class="sec" cx="62" cy="14" r="10" /><text class="tsec" x="78" y="18" style="font-weight:700">cytokine</text>
  <g class="ln-pri" stroke-width="5" stroke-linecap="round"><path d="M38 18 L50 36 V120" /><path d="M86 18 L74 36 V120" /></g>
  <ellipse class="sec-soft" cx="42" cy="128" rx="16" ry="11" /><text class="tsec" x="42" y="132" text-anchor="middle" style="font-size:10px;font-weight:700">JAK</text>
  <ellipse class="sec-soft" cx="82" cy="128" rx="16" ry="11" /><text class="tsec" x="82" y="132" text-anchor="middle" style="font-size:10px;font-weight:700">JAK</text>
  <rect class="pri-soft" x="114" y="140" width="46" height="24" rx="12" /><text class="tp" x="137" y="156" text-anchor="middle" style="font-size:10.5px;font-weight:700">STAT</text>
  <circle class="good" cx="162" cy="140" r="7" /><text class="ton" x="162" y="143.5" text-anchor="middle" style="font-size:9px">P</text>
  <line class="ln" x1="98" y1="134" x2="112" y2="146" marker-end="url(#ah)" />
  <line class="ln" x1="170" y1="152" x2="194" y2="152" marker-end="url(#ah)" />
  <rect class="pri-soft" x="198" y="140" width="40" height="24" rx="12" /><rect class="pri-soft" x="198" y="166" width="40" height="24" rx="12" />
  <text class="tm" x="218" y="134" text-anchor="middle">dimer</text>
  <path class="good-soft" d="M290 104 A64 64 0 0 1 290 232" />
  <line class="ln-good" x1="242" y1="165" x2="280" y2="165" stroke-width="1.5" marker-end="url(#ah-good)" />
  <text class="tg" x="312" y="160" text-anchor="middle" style="font-weight:700">nucleus</text><text class="tm" x="312" y="176" text-anchor="middle">genes</text>
</Figure>
