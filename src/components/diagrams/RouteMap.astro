---
import Figure from '../Figure.astro';
const enteral = [['Oral', 'swallowed'], ['Sublingual, buccal', 'tongue, cheek'], ['Rectal', 'enema, suppository']];
const parenteral = [['Injections', ''], ['Inhalation', ''], ['Topical', ''], ['Transdermal', 'patch (TTS)']];
---
<Figure viewBox="0 0 340 300" maxWidth={460} label="Routes split into enteral: oral, sublingual and buccal, rectal; and parenteral: injections, inhalation, topical, transdermal">
  <rect class="ink" x="130" y="6" width="80" height="32" rx="16" />
  <text class="tl" x="170" y="27" text-anchor="middle" style="fill:var(--bg);font-weight:800">Drug</text>
  <path class="ln" d="M170 38 V52 M85 66 V52 H255 V66" />
  <rect class="pri" x="10" y="66" width="150" height="46" rx="12" />
  <text class="ton tl" x="85" y="86" text-anchor="middle">Enteral</text>
  <text class="ton" x="85" y="103" text-anchor="middle" style="font-weight:500;font-size:11.5px">through the gut</text>
  <rect class="sec" x="180" y="66" width="150" height="46" rx="12" />
  <text class="ton tl" x="255" y="86" text-anchor="middle">Parenteral</text>
  <text class="ton" x="255" y="103" text-anchor="middle" style="font-weight:500;font-size:11.5px">skips the gut</text>
  <line class="ln-pri" x1="28" y1="112" x2="28" y2={136 + (enteral.length - 1) * 48} stroke-width="3" />
  {enteral.map(([name, sub], i) => (
    <g>
      <circle cx="28" cy={136 + i * 48} r="6" style="fill:var(--surface)" class="ln-pri" stroke-width="2.5" />
      <text class="ts" x="42" y={140 + i * 48}>{name}</text>
      {sub && <text class="tm" x="42" y={155 + i * 48}>{sub}</text>}
    </g>
  ))}
  <line class="ln-sec" x1="198" y1="112" x2="198" y2={136 + (parenteral.length - 1) * 42} stroke-width="3" />
  {parenteral.map(([name, sub], i) => (
    <g>
      <circle cx="198" cy={136 + i * 42} r="6" style="fill:var(--surface)" class="ln-sec" stroke-width="2.5" />
      <text class="ts" x="212" y={140 + i * 42}>{name}</text>
      {sub && <text class="tm" x="212" y={155 + i * 42}>{sub}</text>}
    </g>
  ))}
</Figure>
