---
import Figure from '../Figure.astro';
---
<Figure viewBox="0 0 340 252" maxWidth={520} label="Lipid-soluble hormone enters the cell, frees its receptor from HSP-90, the receptor dimer binds a hormone response element on DNA in the nucleus, mRNA leaves and new protein is made">
  <rect class="plain" x="4" y="28" width="332" height="218" rx="30" style="fill:transparent" />
  <circle class="sec" cx="36" cy="12" r="8" /><line class="ln-sec" x1="36" y1="22" x2="52" y2="56" stroke-width="1.6" marker-end="url(#ah-sec)" />
  <text class="tsec" x="52" y="16" style="font-weight:700">lipid-soluble hormone</text>
  <rect class="pri-soft" x="40" y="62" width="44" height="22" rx="8" /><text class="tp" x="62" y="77" text-anchor="middle" style="font-size:10.5px;font-weight:700">R</text>
  <circle class="plain" cx="92" cy="64" r="7" /><circle class="plain" cx="92" cy="82" r="7" /><text class="tm" x="104" y="77">HSP-90</text>
  <line class="ln" x1="62" y1="88" x2="62" y2="116" marker-end="url(#ah)" /><text class="tm" x="70" y="106">HSP-90 leaves</text>
  <rect class="pri-soft" x="40" y="120" width="44" height="18" rx="7" /><rect class="pri-soft" x="40" y="140" width="44" height="18" rx="7" /><text class="tm" x="62" y="174" text-anchor="middle">dimer</text>
  <ellipse class="good-soft" cx="250" cy="134" rx="84" ry="74" style="stroke-opacity:.6" /><text class="tg" x="250" y="80" text-anchor="middle" style="font-weight:700">nucleus</text>
  <line class="ln" x1="88" y1="140" x2="174" y2="140" marker-end="url(#ah)" />
  <path class="ln-pri" d="M170 158 Q185 148 200 158 T230 158 T260 158 T290 158 T320 158" stroke-width="2" /><path class="ln-pri" d="M170 166 Q185 176 200 166 T230 166 T260 166 T290 166 T320 166" stroke-width="2" />
  <rect class="pri" x="216" y="134" width="30" height="16" rx="6" /><rect class="pri" x="248" y="134" width="30" height="16" rx="6" />
  <text class="ts" x="247" y="126" text-anchor="middle" style="font-size:11px">hormone response element</text>
  <path class="ln-sec" d="M240 184 Q220 198 200 188 T160 194" stroke-width="2" marker-end="url(#ah-sec)" /><text class="tsec" x="252" y="198" style="font-weight:700">mRNA</text>
  <ellipse class="good-soft" cx="120" cy="210" rx="26" ry="12" /><text class="tg" x="120" y="214" text-anchor="middle" style="font-size:10px;font-weight:700">ribosome</text>
  <text class="ts" x="36" y="238" style="font-size:11px">→ specific proteins → cell function changes</text>
</Figure>
