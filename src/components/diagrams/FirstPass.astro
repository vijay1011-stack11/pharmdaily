---
import Figure from '../Figure.astro';
---
<Figure viewBox="0 0 340 262" maxWidth={480} label="First-pass metabolism: an oral dose loses some drug in the gut wall (GTN, isoprenaline), then reaches the liver through the portal vein and loses more (lignocaine); only what's left reaches the systemic circulation">
  <rect class="pri-soft" x="8" y="8" width="170" height="40" rx="12" />
  <text class="ts" x="93" y="33" text-anchor="middle">Oral dose</text>
  <rect class="pri" x="196" y="20" width="136" height="14" rx="7" />

  <line class="ln" x1="93" y1="48" x2="93" y2="98" marker-end="url(#ah)" />
  <line class="ln-bad" x1="93" y1="72" x2="128" y2="72" stroke-width="1.6" marker-end="url(#ah-bad)" />
  <text class="tb" y="68" style="font-size:11px">
    <tspan x="134">gut wall: GTN,</tspan><tspan x="134" dy="13">isoprenaline lost</tspan>
  </text>

  <rect class="plain" x="8" y="100" width="170" height="40" rx="12" />
  <text class="ts" x="93" y="125" text-anchor="middle">Portal vein</text>
  <rect class="pri" x="196" y="113" width="96" height="14" rx="7" />

  <line class="ln" x1="93" y1="140" x2="93" y2="190" marker-end="url(#ah)" />
  <line class="ln-bad" x1="93" y1="164" x2="128" y2="164" stroke-width="1.6" marker-end="url(#ah-bad)" />
  <text class="tb" x="134" y="168" style="font-size:11px">liver: lignocaine lost</text>

  <rect class="good-soft" x="8" y="192" width="170" height="52" rx="12" />
  <text class="ts tg" y="214" text-anchor="middle">
    <tspan x="93">Systemic circulation:</tspan><tspan x="93" dy="16">only what's left</tspan>
  </text>
  <rect class="good" x="196" y="211" width="44" height="14" rx="7" />
  <text class="tm" x="264" y="256" text-anchor="middle" style="font-size:10px">bar: drug remaining</text>
</Figure>
