    <path d="M30 22 L42 44 L54 22 M42 44 V128" /><path d="M92 22 L104 44 L116 22 M104 44 V128" />
    <path d="M222 22 L234 44 L246 22 M234 44 V128" /><path d="M252 22 L264 44 L276 22 M264 44 V128" />
