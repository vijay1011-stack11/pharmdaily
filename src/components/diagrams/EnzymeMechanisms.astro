---
import Figure from '../Figure.astro';
const site = 'M20 70 H80 A20 20 0 0 0 120 70 H180 V138 H20 Z';
---
<div class="fig-row three">
  <Figure viewBox="0 0 200 150" label="Competitive inhibitor sits in the catalytic site; the substrate competes for it">
    <path class="pri-soft" d={site} stroke-width="1.5" />
    <circle class="sec" cx="100" cy="70" r="17" /><text class="ton" x="100" y="75" text-anchor="middle">I</text>
    <circle class="ln-pri" cx="38" cy="28" r="14" stroke-width="1.5" stroke-dasharray="4 3" /><text class="tp" x="38" y="33" text-anchor="middle">S</text>
    <path class="ln" d="M54 34 Q70 44 78 54" marker-end="url(#ah)" />
    <text class="tm" x="142" y="34" text-anchor="middle">both fit the site</text>
    <text class="tm" x="100" y="118" text-anchor="middle">enzyme</text>
    <Fragment slot="after">
      <p class="fig-title">Competitive (equilibrium type)</p>
      <div class="badges"><span class="badge bad">Km ↑</span><span class="badge good">Vmax =</span></div>
    </Fragment>
  </Figure>
  <Figure viewBox="0 0 200 150" label="Non-equilibrium inhibitor locked into the catalytic site; substrate cannot displace it">
    <path class="pri-soft" d={site} stroke-width="1.5" />
    <circle class="sec" cx="100" cy="70" r="17" /><text class="ton" x="100" y="75" text-anchor="middle">I</text>
    <g class="ln-ink" stroke-width="2.4" stroke-linecap="round"><line x1="93" y1="88" x2="93" y2="98" /><line x1="100" y1="89" x2="100" y2="99" /><line x1="107" y1="88" x2="107" y2="98" /></g>
    <circle class="ln-pri" cx="38" cy="28" r="14" stroke-width="1.5" stroke-dasharray="4 3" /><text class="tp" x="38" y="33" text-anchor="middle">S</text>
    <g class="ln-bad" stroke-width="2"><line x1="60" y1="20" x2="72" y2="36" /><line x1="72" y1="20" x2="60" y2="36" /></g>
    <text class="tm" x="142" y="34" text-anchor="middle">can't displace</text>
    <text class="tm" x="100" y="118" text-anchor="middle">covalent bond</text>
    <Fragment slot="after">
      <p class="fig-title">Non-equilibrium type</p>
      <div class="badges"><span class="badge bad">Km ↑</span><span class="badge bad">Vmax ↓</span></div>
    </Fragment>
  </Figure>
  <Figure viewBox="0 0 200 150" label="Non-competitive inhibitor binds an adjacent site and changes the catalytic site">
    <path class="pri-soft" d="M20 70 H90 A10 10 0 0 0 110 70 H180 V92 A11 11 0 0 0 180 114 V138 H20 Z" stroke-width="1.5" />
    <circle class="sec" cx="181" cy="103" r="10" /><text class="ton" x="181" y="107" text-anchor="middle" style="font-size:10px">I</text>
    <circle class="ln-pri" cx="100" cy="46" r="15" stroke-width="1.5" stroke-dasharray="4 3" /><text class="tp" x="100" y="51" text-anchor="middle">S</text>
    <text class="tm" x="46" y="34" text-anchor="middle">site changed</text>
    <text class="tm" x="100" y="118" text-anchor="middle">adjacent site</text>
    <Fragment slot="after">
      <p class="fig-title">Non-competitive</p>
      <div class="badges"><span class="badge good">Km =</span><span class="badge bad">Vmax ↓</span></div>
    </Fragment>
  </Figure>
</div>
