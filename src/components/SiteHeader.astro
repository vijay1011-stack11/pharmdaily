---
const path = Astro.url.pathname;
const links = [
  { href: '/#sections', label: 'Sections' },
  { href: '/about/', label: 'About' },
];
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand press" href="/" aria-label="PharmDaily home">
      <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true"><rect width="32" height="32" rx="8" fill="var(--primary)" /><rect x="7" y="12" width="18" height="8" rx="4" fill="var(--on-primary)" /><path d="M16 12h5a4 4 0 0 1 0 8h-5z" fill="var(--primary-line)" /></svg>
      <span>PharmDaily</span>
    </a>
    <nav aria-label="Site">
      {links.map((l) => (
        <a class="press" href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header { border-bottom: 1px solid var(--line); background: var(--surface); padding-top: env(safe-area-inset-top); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 56px; }
  .brand { display: inline-flex; align-items: center; gap: 9px; min-height: 44px; font-weight: 800; font-size: 1.08rem; letter-spacing: -0.02em; color: var(--heading); text-decoration: none; }
  nav { display: flex; gap: 2px; }
  nav a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 12px; border-radius: 999px; color: var(--fg); text-decoration: none; font-weight: 550; font-size: 0.94rem; border: 1px solid transparent; }
  nav a[aria-current='page'] { color: var(--primary-ink); }
</style>
