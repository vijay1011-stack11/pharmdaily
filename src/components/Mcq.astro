---
import type { Mcq } from '../lib/content';
interface Props { items: Mcq[]; storeKey: string }
const { items, storeKey } = Astro.props;
const letters = ['A', 'B', 'C', 'D'];
---
<div class="mcq" data-mcq-set data-key={storeKey}>
  <div class="mcq-head">
    <div>
      <h2 class="mcq-h">MCQs</h2>
      <p class="score tabular" aria-live="polite" data-score>{items.length} questions</p>
    </div>
    <button type="button" class="btn press" data-reset>Start again</button>
  </div>
  <ol class="qs">
    {items.map((m, n) => (
      <li class="q-card" data-mcq data-answer={m.answer} data-explanation={m.explanation}>
        <p class="qn tabular">Question {n + 1} of {items.length}</p>
        <p class="qt" id={`${storeKey}-q${n}`}>{m.q}</p>
        <div class="opts" role="group" aria-labelledby={`${storeKey}-q${n}`}>
          {m.options.map((o, k) => (
            <button type="button" class="opt press" data-k={k}>
              <span class="letter" aria-hidden="true">{letters[k]}</span>
              <span class="otext">{o}</span>
            </button>
          ))}
        </div>
        <p class="result" data-result hidden></p>
      </li>
    ))}
  </ol>
  <noscript><p class="noscript">MCQs need JavaScript to check your answers.</p></noscript>
</div>

<script>
  import { load, save, idOf } from '../scripts/store';

  for (const root of document.querySelectorAll<HTMLElement>('[data-mcq-set]')) {
    const key = root.dataset.key!;
    const qs = Array.from(root.querySelectorAll<HTMLElement>('[data-mcq]'));
    const ids = qs.map((q) => idOf(q.querySelector('.qt')!.textContent!));
    const score = root.querySelector('[data-score]')!;
    let chosen: Record<string, number> = load(key, {});

    function paint(q: HTMLElement, i: number) {
      const pick = chosen[ids[i]];
      const answer = Number(q.dataset.answer);
      const opts = Array.from(q.querySelectorAll<HTMLButtonElement>('.opt'));
      const result = q.querySelector<HTMLElement>('[data-result]')!;
      const answered = pick !== undefined;
      opts.forEach((o, k) => {
        o.disabled = answered;
        o.classList.toggle('right', answered && k === answer);
        o.classList.toggle('wrong', answered && k === pick && k !== answer);
        o.setAttribute('aria-pressed', String(answered && k === pick));
      });
      result.hidden = !answered;
      result.className = 'result ' + (pick === answer ? 'is-right' : 'is-wrong');
      result.textContent = answered ? `${pick === answer ? 'Correct.' : 'Not quite.'} ${q.dataset.explanation}` : '';
    }

    function tally() {
      const answered = ids.filter((id) => chosen[id] !== undefined);
      const right = qs.filter((q, i) => chosen[ids[i]] === Number(q.dataset.answer)).length;
      score.textContent = answered.length
        ? `Score ${right} / ${answered.length} · ${qs.length - answered.length} left`
        : `${qs.length} questions`;
    }

    qs.forEach((q, i) => {
      q.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.opt');
        if (!b || b.disabled) return;
        chosen[ids[i]] = Number(b.dataset.k);
        save(key, chosen);
        paint(q, i);
        tally();
      });
      paint(q, i);
    });
    root.querySelector('[data-reset]')!.addEventListener('click', () => {
      chosen = {};
      save(key, chosen);
      qs.forEach(paint);
      tally();
      root.scrollIntoView({ block: 'start' });
    });
    tally();
  }
</script>

<style>
  .mcq-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .mcq-h { font-size: 1.35rem; font-weight: 750; }
  .score { margin: 2px 0 0; font-weight: 650; color: var(--primary-ink); font-size: 0.92rem; }
  .qs { list-style: none; margin: 14px 0 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .q-card { padding: 16px; border-radius: 16px; background: var(--surface); border: 1px solid var(--line); }
  .qn { margin: 0; font-size: 0.78rem; font-weight: 600; color: var(--muted); }
  .qt { margin: 4px 0 12px; font-weight: 700; font-size: 1.05rem; line-height: 1.4; color: var(--heading); }
  .opts { display: flex; flex-direction: column; gap: 8px; }
  .opt {
    display: grid; grid-template-columns: 28px minmax(0, 1fr); align-items: center; gap: 10px; width: 100%;
    min-height: 50px; padding: 10px 14px 10px 10px; text-align: left; cursor: pointer;
    border-radius: 12px; border: 1px solid var(--line-strong); background: var(--surface); font-size: 0.97rem; line-height: 1.35;
  }
  .opt[disabled] { cursor: default; }
  .letter { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 8px; background: var(--surface-2); font-size: 0.8rem; font-weight: 700; color: var(--muted); }
  .opt.right { border-color: var(--good); background: var(--good-soft); color: var(--good-ink); font-weight: 650; }
  .opt.right .letter { background: var(--good); color: var(--on-primary); }
  .opt.wrong { border-color: var(--bad); background: var(--bad-soft); color: var(--bad-ink); }
  .opt.wrong .letter { background: var(--bad); color: var(--on-primary); }
  .opt[disabled]:not(.right):not(.wrong) { opacity: 0.7; }
  .result { margin: 12px 0 0; padding: 10px 12px; border-radius: 10px; font-size: 0.93rem; background: var(--surface-2); }
  .result.is-right { border-left: 3px solid var(--good); }
  .result.is-wrong { border-left: 3px solid var(--bad); }
  .noscript { color: var(--muted); font-size: 0.9rem; }
</style>
