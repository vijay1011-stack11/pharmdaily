---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SECTIONS, isLive, topicPath, type Section } from '../../lib/sections';
import { getFlashcards, getMcqs, getNotes } from '../../lib/content';

export function getStaticPaths() {
  return SECTIONS.filter(isLive).map((s) => ({ params: { section: `section-${s.n}` }, props: { s } }));
}
const { s } = Astro.props as { s: Section };
const topics = s.topics.map((t) => ({
  t,
  hero: getNotes(s.n, t.slug).hero,
  cards: getFlashcards(s.n, t.slug).length,
  mcqs: getMcqs(s.n, t.slug).length,
}));
---
<BaseLayout title={`Section ${s.n}: ${s.title}`} description={`${s.title}: ${s.topics.map((t) => t.title).join(', ')}.`}>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Section {s.n}</span></nav>
    <header class="head">
      <p class="eyebrow">Section {s.n}</p>
      <h1>{s.title}</h1>
      <p class="sub">{s.topics.length} topics. Read the notes first, then test yourself.</p>
    </header>
    <ol class="topics">
      {topics.map(({ t, hero, cards, mcqs }, i) => (
        <li>
          <a class="topic press" href={topicPath(s, t)}>
            <span class="idx tabular">{i + 1}</span>
            <span class="txt">
              <span class="title">{t.title}</span>
              <span class="h">{hero.title}</span>
              <span class="lede" set:html={hero.lede} />
              <span class="counts tabular"><span>Notes</span><span>{cards} flashcards</span><span>{mcqs} MCQs</span></span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</BaseLayout>

<style>
  .crumbs { display: flex; gap: 8px; align-items: center; padding-top: 14px; font-size: 0.88rem; color: var(--muted); }
  .crumbs a { color: var(--muted); display: inline-flex; min-height: 44px; align-items: center; }
  .head { padding: 8px 0 18px; border-bottom: 2px solid var(--heading); }
  .head h1 { font-size: clamp(1.9rem, 6vw, 2.6rem); font-weight: 800; letter-spacing: -0.03em; margin-top: 6px; }
  .sub { color: var(--muted); margin: 8px 0 0; }
  .topics { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 900px) { .topics { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 20px; } }
  .topics li { border-bottom: 1px solid var(--line); }
  @media (min-width: 900px) { .topics li { border: 0; } }
  .topic { display: grid; grid-template-columns: 36px minmax(0, 1fr); gap: 12px; padding: 20px 2px; color: inherit; text-decoration: none; border: 1px solid transparent; border-radius: var(--radius); height: 100%; }
  @media (min-width: 900px) { .topic { background: var(--surface); border-color: var(--line); padding: 20px; } }
  .idx { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--primary); color: var(--on-primary); font-weight: 700; font-size: 0.88rem; }
  .txt { display: flex; flex-direction: column; min-width: 0; }
  .title { font-size: 1.18rem; font-weight: 750; color: var(--heading); letter-spacing: -0.015em; }
  .h { font-weight: 600; color: var(--primary-ink); margin-top: 2px; }
  .lede { color: var(--muted); font-size: 0.94rem; margin-top: 6px; }
  .counts { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  .counts span { font-size: 0.78rem; font-weight: 600; padding: 2px 9px; border-radius: 999px; background: var(--surface-2); color: var(--fg); }
</style>
